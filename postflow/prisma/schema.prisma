  collectionId String
  collection   PostCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  postId       String
  post         Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  addedAt      DateTime       @default(now())

  @@id([collectionId, postId])
  @@index([collectionId])
  @@index([postId])
}

model ChangelogEntry {
  id          String              @id @default(cuid())
  title       String
  summary     String
  body        String
  type        String              // feature | improvement | bugfix
  version     String?
  publishedAt DateTime
  isPublished Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  views       UserChangelogView[]

  @@index([isPublished, publishedAt(sort: Desc)])
  @@index([publishedAt(sort: Desc)])
}

model UserChangelogView {
  id       String         @id @default(cuid())
  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryId  String
  entry    ChangelogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  viewedAt DateTime       @default(now())

  @@unique([userId, entryId])
  @@index([userId])
  @@index([entryId])
}
