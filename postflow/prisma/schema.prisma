// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  THREADS
  LINKEDIN
  PINTEREST
  YOUTUBE
  TIKTOK
  TWITTER
  BLUESKY
  MASTODON
  TELEGRAM
  REDDIT
  NOSTR
  TUMBLR
  WORDPRESS
  MEDIUM
  GHOST
  DEVTO
  GOOGLE_BUSINESS
  HASHNODE
  BEEHIIV
  PIXELFED
  VIMEO
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
}

enum MediaType {
  NONE
  IMAGE
  VIDEO
  CAROUSEL
}

enum PublishStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum ApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum TeamRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ImportStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AlertMetric {
  IMPRESSIONS
  REACH
  LIKES
  COMMENTS
  SHARES
  SCORE
}

enum AlertOperator {
  ABOVE
  BELOW
}

enum ContentCategory {
  EDUCATIONAL
  PROMOTIONAL
  ENTERTAINING
  ENGAGING
  INSPIRING
  NEWS
  BEHIND_THE_SCENES
  USER_GENERATED
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  password           String?
  timezone           String              @default("UTC")
  emailNotifications Boolean             @default(true)
  theme              String              @default("system")
  onboardingDismissed Boolean            @default(false)
  totpSecret         String?
  totpEnabled        Boolean             @default(false)
  totpBackupCodes    String[]
  stripeCustomerId   String?
  planTier           String              @default("free")
  planExpiresAt      DateTime?
  accounts           SocialAccount[]
  posts              Post[]
  templates          Template[]
  recurringSchedules RecurringSchedule[]
  activityLogs       ActivityLog[]
  notifications      Notification[]
  mediaAssets        MediaAsset[]
  tags               Tag[]
  hashtagGroups      HashtagGroup[]
  postQueueSlots     PostQueueSlot[]
  webhookConfigs     WebhookConfig[]
  calendarToken      CalendarToken?
  shareLinks         ShareLink[]
  campaigns          Campaign[]
  rssFeeds           RssFeed[]
  teamMemberships    TeamMember[]
  apiKeys            ApiKey[]
  passwordResetTokens PasswordResetToken[]
  reportSchedules    ReportSchedule[]
  importBatches      ImportBatch[]
  filterPresets      FilterPreset[]
  abTests            PostABTest[]
  performanceAlerts  PerformanceAlert[]
  utmPresets         UtmPreset[]
  contentIdeas       ContentIdea[]
  postingGoals       PostingGoal[]
  contentSnippets    ContentSnippet[]
  draftAutosave      DraftAutosave?
  slackIntegrations  SlackIntegration[]
  discordIntegrations DiscordIntegration[]
  linkBioPages       LinkBioPage[]
  feedWidgets        FeedWidget[]
  contentPillars     ContentPillar[]
  shortLinks         ShortLink[]
  pushSubscriptions  PushSubscription[]
  blackoutPeriods    BlackoutPeriod[]
  brandKit                 BrandKit?
  notificationPreferences  NotificationPreference[]
  inspirationItems         InspirationItem[]
  accountGroups            AccountGroup[]
  captionVariables         CaptionVariable[]
  assignedPosts            Post[]              @relation("PostAssignee")
  scheduleTimePresets  ScheduleTimePreset[]
  dashboardWidgets     DashboardWidget[]
  savedAnalyticsViews  SavedAnalyticsView[]
  aiPersonas           AiPersona[]
  tourProgress         TourProgress?
  coachingInsights     CoachingInsight[]
  achievements         Achievement[]
  analyticsSnapshots   AnalyticsSnapshot[]
  checklistItems       ChecklistItem[]
  postChecklistRecords PostChecklistRecord[]
  collections          PostCollection[]
  publishingPaused       Boolean   @default(false)
  publishingPausedReason String?
  publishingPausedAt     DateTime?
  changelogViews         UserChangelogView[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String
  read       Boolean  @default(false)
  entityId   String?
  entityType String?
  createdAt  DateTime @default(now())

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model SocialAccount {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id])
  platform          Platform
  platformAccountId String
  accountName       String
  encryptedToken    String
  tokenExpiresAt    DateTime?
  scopes            String
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  audienceMetrics   AudienceMetric[]

  @@unique([userId, platform, platformAccountId])
  @@index([userId])
  @@index([isActive, tokenExpiresAt])
}

model AudienceMetric {
  id             String        @id @default(cuid())
  accountId      String
  account        SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  followersCount Int?
  followingCount Int?
  syncedAt       DateTime      @default(now())

  @@index([accountId, syncedAt])
}

model Post {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  content        String
  mediaType      MediaType
  mediaUrls      String[]
  status          PostStatus
  scheduledAt     DateTime?
  reminderMinutes Int?
  starred         Boolean        @default(false)
  isEvergreen    Boolean        @default(false)
  approvalStatus ApprovalStatus @default(NONE)
  approverNote   String?
  sentiment      String?
  sentimentScore Float?
  tone           String?
  toneTraits     String[]
  firstComment   String?
  language       String?
  contentCategory ContentCategory?
  altTexts       String[]
  archivedAt       DateTime?
  expiresAt        DateTime?
  recycleInterval  Int?
  lastRecycledAt   DateTime?
  pillarId       String?
  pillar         ContentPillar? @relation(fields: [pillarId], references: [id])
  assigneeId     String?
  assignee       User?          @relation("PostAssignee", fields: [assigneeId], references: [id])
  publishResults PublishResult[]
  tags           PostTag[]
  versions       PostVersion[]
  variants       PostVariant[]
  comments       PostComment[]
  shareLinks     ShareLink[]
  campaigns      CampaignPost[]
  rssItems       RssItem[]
  abTestsAsA     PostABTest[]   @relation("ABTestVariantA")
  abTestsAsB     PostABTest[]   @relation("ABTestVariantB")
  threadPosts    ThreadPost[]
  poll           PostPoll?
  checklistRecord PostChecklistRecord?
  collections    CollectionPost[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([scheduledAt])
  @@index([status, scheduledAt])
  @@index([userId, archivedAt])
  @@index([userId, pillarId])
  @@index([expiresAt])
  @@index([isEvergreen, lastRecycledAt])
  @@index([assigneeId])
  @@index([userId, tone])
}

model ThreadPost {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  order     Int
  content   String
  mediaUrls String[]
  mediaType MediaType @default(NONE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([postId])
  @@index([postId, order])
}

model Template {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  content   String
  mediaType MediaType @default(NONE)
  mediaUrls String[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
}

model RecurringSchedule {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  content   String
  mediaType MediaType @default(NONE)
  mediaUrls String[]
  platforms Platform[]
  cronExpr  String
  timezone  String    @default("UTC")
  isActive  Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([isActive, nextRunAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  entityId   String?
  entityType String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, entityType])
}

model PublishResult {
  id             String        @id @default(cuid())
  postId         String
  post           Post          @relation(fields: [postId], references: [id])
  platform       Platform
  accountId      String
  platformPostId String?
  status         PublishStatus
  error          String?
  publishedUrl   String?
  publishedAt    DateTime?
  retryCount     Int           @default(0)
  insights       PostInsights?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([postId])
  @@index([postId, status])
  @@index([status])
}

model MediaAsset {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String
  size        Int
  r2Key       String
  publicUrl   String
  description String?
  tags        String[] @default([])
  createdAt   DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model Tag {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String    @default("#6366f1")
  posts     PostTag[]
  createdAt DateTime  @default(now())

  @@unique([userId, name])
  @@index([userId])
}

model PostTag {
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([postId, tagId])
  @@index([postId])
  @@index([tagId])
}

model HashtagGroup {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  hashtags  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
}

model PostQueueSlot {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String    @default("")
  platform   Platform?
  hour       Int
  minute     Int       @default(0)
  daysOfWeek Int[]
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([userId, isActive])
}

model WebhookConfig {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  url        String
  events     String[]
  secret     String
  isActive   Boolean           @default(true)
  deliveries WebhookDelivery[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId])
  @@index([userId, isActive])
}

model WebhookDelivery {
  id          String        @id @default(cuid())
  configId    String
  config      WebhookConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  event       String
  statusCode  Int?
  success     Boolean
  durationMs  Int
  attemptedAt DateTime      @default(now())

  @@index([configId, attemptedAt(sort: Desc)])
}

model PostVersion {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  content   String
  mediaType MediaType
  mediaUrls String[]
  createdAt DateTime  @default(now())

  @@index([postId, createdAt(sort: Desc)])
  @@index([userId])
}

model PostVariant {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform  Platform
  content   String
  mediaType MediaType @default(NONE)
  mediaUrls String[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([postId, platform])
  @@index([postId])
}

model CalendarToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())

  @@index([token])
}

model PostComment {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId     String
  authorName String
  comment    String
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([postId, createdAt(sort: Desc)])
  @@index([userId])
}

model PostInsights {
  id             String        @id @default(cuid())
  publishResultId String       @unique
  publishResult  PublishResult @relation(fields: [publishResultId], references: [id], onDelete: Cascade)
  impressions    Int?
  reach          Int?
  likes          Int?
  comments       Int?
  shares         Int?
  syncedAt       DateTime      @default(now())

  @@index([publishResultId])
}

model ShareLink {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique @default(cuid())
  expiresAt DateTime?
  views     Int       @default(0)
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
  @@index([token])
  @@index([userId])
}

model Campaign {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  goal        String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean        @default(true)
  posts       CampaignPost[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, createdAt(sort: Desc)])
}

model CampaignPost {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@id([campaignId, postId])
  @@index([campaignId])
  @@index([postId])
}

model RssFeed {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  url           String
  autoCreate    Boolean   @default(true)
  lastFetchedAt DateTime?
  items         RssItem[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, url])
  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
}

model RssItem {
  id          String    @id @default(cuid())
  feedId      String
  feed        RssFeed   @relation(fields: [feedId], references: [id], onDelete: Cascade)
  guid        String
  title       String?
  content     String?
  link        String?
  imageUrl    String?
  publishedAt DateTime?
  postId      String?
  post        Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  importedAt  DateTime  @default(now())

  @@unique([feedId, guid])
  @@index([feedId])
  @@index([postId])
  @@index([feedId, importedAt(sort: Desc)])
}

model Team {
  id        String       @id @default(cuid())
  name      String
  ownerId   String
  members   TeamMember[]
  invites   TeamInvite[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([ownerId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TeamRole @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model TeamInvite {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email     String?
  token     String   @unique @default(cuid())
  role      TeamRole @default(EDITOR)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([teamId])
  @@index([token])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([keyHash])
  @@index([userId, createdAt(sort: Desc)])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model ReportSchedule {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  frequency      ReportFrequency
  recipientEmail String
  isActive       Boolean         @default(true)
  lastSentAt     DateTime?
  nextSendAt     DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@index([isActive, nextSendAt])
  @@index([userId, createdAt(sort: Desc)])
}

model ImportBatch {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename    String
  totalRows   Int
  successRows Int          @default(0)
  failedRows  Int          @default(0)
  errors      Json         @default("[]")
  status      ImportStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
}

model FilterPreset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
}

model PostABTest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  postAId   String
  postA     Post     @relation("ABTestVariantA", fields: [postAId], references: [id], onDelete: Cascade)
  postBId   String
  postB     Post     @relation("ABTestVariantB", fields: [postBId], references: [id], onDelete: Cascade)
  winner    String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
}

model PerformanceAlert {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  metric          AlertMetric
  operator        AlertOperator
  threshold       Float
  platform        Platform?
  period          String        @default("7d")
  isActive        Boolean       @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([isActive])
  @@index([userId, createdAt(sort: Desc)])
}

model UtmPreset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  source    String
  medium    String
  campaign  String?
  content   String?
  term      String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isDefault])
  @@index([userId, createdAt(sort: Desc)])
}

enum IdeaStatus {
  IDEA
  RESEARCHING
  DRAFTING
  REVIEW
  DONE
}

model ContentIdea {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      IdeaStatus @default(IDEA)
  platform    Platform?
  notes       String?
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
}

enum GoalPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

model PostingGoal {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  targetCount Int
  period      GoalPeriod
  platform    Platform?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, createdAt(sort: Desc)])
}

model ContentSnippet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  content   String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, category])
  @@index([userId, createdAt(sort: Desc)])
}

model DraftAutosave {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content            String
  scheduledAt        DateTime?
  firstComment       String?
  selectedAccountIds String[]
  tagIds             String[]
  platformVariants   Json?
  updatedAt          DateTime  @updatedAt
}

model SlackIntegration {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceName String
  webhookUrl    String
  events        String[]
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, createdAt(sort: Desc)])
}

model DiscordIntegration {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelName String
  webhookUrl  String
  events      String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, isActive])
