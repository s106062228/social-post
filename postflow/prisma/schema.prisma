enum PromotionStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

model PostPromotion {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId       String?
  post         Post?           @relation(fields: [postId], references: [id], onDelete: SetNull)
  platform     Platform
  campaignName String
  budget       Float
  spend        Float           @default(0)
  currency     String          @default("USD")
  startDate    DateTime
  endDate      DateTime?
  goal         String?
  status       PromotionStatus @default(PLANNED)
  impressions  Int?
  clicks       Int?
  conversions  Int?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([postId])
}

model CustomField {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  key          String
  label        String
  fieldType    String               // "text" | "number" | "date" | "url" | "select"
  options      String[]             @default([])
  defaultValue String?
  isRequired   Boolean              @default(false)
  isActive     Boolean              @default(true)
  order        Int                  @default(0)
  values       PostCustomFieldValue[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

model PostCustomFieldValue {
  id        String      @id @default(cuid())
  postId    String
  post      Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  fieldId   String
  field     CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  value     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([postId, fieldId])
  @@index([postId])
  @@index([fieldId])
}

model PostLock {
  id        String   @id @default(cuid())
  postId    String   @unique
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lockedAt  DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

enum SequenceStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model PostSequence {
