# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postflow

# Redis
REDIS_URL=redis://localhost:6379

# NextAuth.js
NEXTAUTH_SECRET=your-random-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Meta Developer App
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_OAUTH_CALLBACK_URL=http://localhost:3000/api/oauth/meta/callback
# Webhook verify token — set a random string and configure the same value in the Meta App Dashboard
META_WEBHOOK_VERIFY_TOKEN=your-random-webhook-verify-token

# Token Encryption (AES-256-GCM) — generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-key

# Cloudflare R2 (S3-compatible media storage)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=postflow-media
R2_PUBLIC_URL=https://media.your-domain.com

# SMTP Email Notifications (optional — leave blank to disable email notifications)
# Compatible with any SMTP provider (Gmail, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# SMTP_FROM="PostFlow <noreply@example.com>"   # defaults to SMTP_USER if not set

# Anthropic API (optional — leave blank to disable AI content suggestions)
# ANTHROPIC_API_KEY=sk-ant-your-api-key

# LinkedIn Developer App (optional — leave blank to disable LinkedIn publishing)
# Create at https://www.linkedin.com/developers/apps
# Required scopes: openid profile w_member_social
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# LINKEDIN_OAUTH_CALLBACK_URL=http://localhost:3000/api/oauth/linkedin/callback

# Pinterest Developer App (optional — leave blank to disable Pinterest publishing)
# Create at https://developers.pinterest.com/
# Required scopes: boards:read pins:read pins:write user_accounts:read
# PINTEREST_CLIENT_ID=your-pinterest-app-id
# PINTEREST_CLIENT_SECRET=your-pinterest-app-secret
# PINTEREST_OAUTH_CALLBACK_URL=http://localhost:3000/api/oauth/pinterest/callback

# YouTube / Google OAuth (optional — leave blank to disable YouTube publishing)
# Create at https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3; Required scopes: youtube.upload youtube.readonly
# YOUTUBE_CLIENT_ID=your-google-oauth-client-id
# YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
# YOUTUBE_OAUTH_CALLBACK_URL=http://localhost:3000/api/oauth/youtube/callback

# TikTok Developer App (optional — leave blank to disable TikTok publishing)
# Create at https://developers.tiktok.com/
# Required scopes: user.info.basic,video.publish
# TIKTOK_CLIENT_KEY=your-tiktok-client-key
# TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
# TIKTOK_OAUTH_CALLBACK_URL=http://localhost:3000/api/oauth/tiktok/callback

# X (Twitter) Developer App (optional — leave blank to disable Twitter publishing)
# Create at https://developer.twitter.com/en/portal/dashboard
# Required scopes: tweet.write tweet.read users.read offline.access
# Enable OAuth 2.0 with PKCE in the app settings
# TWITTER_CLIENT_ID=your-twitter-oauth2-client-id
# TWITTER_CLIENT_SECRET=your-twitter-oauth2-client-secret
# TWITTER_OAUTH_CALLBACK_URL=http://localhost:3000/api/oauth/twitter/callback

# Bluesky (always enabled — no client credentials needed)
# Users connect via Bluesky app passwords (Settings → App Passwords on bsky.app)
# No environment variables required for Bluesky integration

# Mastodon (always enabled — no client credentials needed)
# Users connect via a Mastodon access token generated in their instance's developer settings
# Supports any Mastodon-compatible instance (e.g. mastodon.social, fosstodon.org)
# No environment variables required for Mastodon integration

# Telegram (always enabled — no client credentials needed)
# Users connect via a Telegram Bot API token created via @BotFather
# The bot must be added as an administrator to the target channel or group
# No environment variables required for Telegram integration

# Reddit Developer App (optional — leave blank to disable Reddit publishing)
# Create at https://www.reddit.com/prefs/apps — choose "web app" type
# Required scopes: submit identity mysubreddits
# REDDIT_CLIENT_ID=your-reddit-client-id
# REDDIT_CLIENT_SECRET=your-reddit-client-secret
# REDDIT_OAUTH_CALLBACK_URL=http://localhost:3000/api/oauth/reddit/callback

# Nostr (optional — no client credentials required)
# Users connect by entering their private key (nsec or hex) and relay URLs
# directly in the PostFlow UI. No server-side credentials are needed.

# Tumblr Developer App (optional — leave blank to disable Tumblr publishing)
# Create at https://www.tumblr.com/oauth/apps
# Required scopes: basic write offline_access
# TUMBLR_CLIENT_ID=your-tumblr-client-id
# TUMBLR_CLIENT_SECRET=your-tumblr-client-secret
# TUMBLR_OAUTH_CALLBACK_URL=http://localhost:3000/api/oauth/tumblr/callback

# WordPress.com OAuth App (optional — leave blank to disable WordPress publishing)
# Create at https://developer.wordpress.com/apps/new/
# Required scopes: posts global
# WORDPRESS_CLIENT_ID=your-wordpress-client-id
# WORDPRESS_CLIENT_SECRET=your-wordpress-client-secret
# WORDPRESS_OAUTH_CALLBACK_URL=http://localhost:3000/api/oauth/wordpress/callback

# Medium OAuth App (optional — leave blank to disable Medium publishing)
# Create at https://medium.com/me/applications
# Required scopes: basicProfile publishPost
# MEDIUM_CLIENT_ID=your-medium-client-id
# MEDIUM_CLIENT_SECRET=your-medium-client-secret
# MEDIUM_OAUTH_CALLBACK_URL=http://localhost:3000/api/oauth/medium/callback

# Ghost CMS (optional — no client credentials required)
# Users connect by entering their Ghost instance URL and Admin API key ({id}:{secret} format)
# directly in the PostFlow UI. Generate an Admin API key in Ghost Admin → Settings → Integrations → Add custom integration.
# No server-side credentials are needed.

# Dev.to (optional — no client credentials required)
# Users connect by entering their Dev.to personal API key directly in the PostFlow UI.
# Generate a personal API key at https://dev.to/settings/extensions under "DEV API Keys".
# No server-side credentials are needed.
