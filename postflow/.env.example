# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postflow

# Redis
REDIS_URL=redis://localhost:6379

# NextAuth.js
NEXTAUTH_SECRET=your-random-secret-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# Meta Developer App
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_OAUTH_CALLBACK_URL=http://localhost:3000/api/oauth/meta/callback
# Webhook verify token — set a random string and configure the same value in the Meta App Dashboard
META_WEBHOOK_VERIFY_TOKEN=your-random-webhook-verify-token

# Token Encryption (AES-256-GCM) — generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-key

# Cloudflare R2 (S3-compatible media storage)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=postflow-media
R2_PUBLIC_URL=https://media.your-domain.com

# SMTP Email Notifications (optional — leave blank to disable email notifications)
# Compatible with any SMTP provider (Gmail, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# SMTP_FROM="PostFlow <noreply@example.com>"   # defaults to SMTP_USER if not set

# Anthropic API (optional — leave blank to disable AI content suggestions)
# ANTHROPIC_API_KEY=sk-ant-your-api-key

# LinkedIn Developer App (optional — leave blank to disable LinkedIn publishing)
# Create at https://www.linkedin.com/developers/apps
# Required scopes: openid profile w_member_social
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# LINKEDIN_OAUTH_CALLBACK_URL=http://localhost:3000/api/oauth/linkedin/callback

# Pinterest Developer App (optional — leave blank to disable Pinterest publishing)
# Create at https://developers.pinterest.com/
# Required scopes: boards:read pins:read pins:write user_accounts:read
# PINTEREST_CLIENT_ID=your-pinterest-app-id
# PINTEREST_CLIENT_SECRET=your-pinterest-app-secret
# PINTEREST_OAUTH_CALLBACK_URL=http://localhost:3000/api/oauth/pinterest/callback

# YouTube / Google OAuth (optional — leave blank to disable YouTube publishing)
# Create at https://console.cloud.google.com/apis/credentials
# Enable YouTube Data API v3; Required scopes: youtube.upload youtube.readonly
# YOUTUBE_CLIENT_ID=your-google-oauth-client-id
# YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
# YOUTUBE_OAUTH_CALLBACK_URL=http://localhost:3000/api/oauth/youtube/callback

# TikTok Developer App (optional — leave blank to disable TikTok publishing)
# Create at https://developers.tiktok.com/
# Required scopes: user.info.basic,video.publish
# TIKTOK_CLIENT_KEY=your-tiktok-client-key
# TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
# TIKTOK_OAUTH_CALLBACK_URL=http://localhost:3000/api/oauth/tiktok/callback
